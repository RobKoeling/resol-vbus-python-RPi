[Unit]
Description=RESOL VBUS Flask UI
After=network.target

[Service]
Type=simple
User=rob
WorkingDirectory=/home/rob/resol-vbus-python-RPi
Environment=PATH=/home/rob/.local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/rob/resol-vbus-python-RPi/ui/run_server.py
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
